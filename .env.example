# Local sync process only. Copy to .env.amazon.local and fill in privately.
# Never prefix secrets with VITE_: that exposes them to the browser bundle.
AMAZON_SP_CLIENT_ID=
AMAZON_SP_CLIENT_SECRET=
AMAZON_SP_REFRESH_TOKEN=
AMAZON_SP_REGION=EU
AMAZON_SP_MARKETPLACE_ID=A21TJRUUN4KGV

# Shared seller mode: server-only Netlify environment variables.
# This is your APP login, not your Netlify/Amazon password. No public signup.
AZULIA_OWNER_EMAIL=
# Generate locally with npm run shared:password (private stdin; see setup guide).
AZULIA_OWNER_PASSWORD_HASH=
# 32 random bytes encoded as 64 hex characters. Keep a secure backup.
AZULIA_CREDENTIAL_KEY=
# Netlify provisions the database connection automatically on deployment.
# Do not put NETLIFY_DB_URL in VITE_ variables or override its branch selection.
# Exact additional frontend origins, comma separated; no wildcard.
AZULIA_ALLOWED_ORIGINS=http://127.0.0.1:8788

# Public frontend settings. These contain NO credentials.
# Netlify sets shared mode in netlify.toml.
# VITE_AZULIA_DELIVERY=shared
# For the local UI to use the same cloud account:
# VITE_AZULIA_SHARED_ENDPOINT=https://YOUR_SITE.netlify.app/.netlify/functions/shared
