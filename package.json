{
  "name": "seller-analytics-workbench",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/build-device-engine.mjs",
    "typecheck": "tsc -b && tsc -p server/local/tsconfig.json && tsc -p server/relay/tsconfig.json",
    "benchmark:analytics": "node scripts/benchmark-analytics.mjs",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "preview": "vite preview",
    "test:pwa": "playwright test --config playwright.pwa.config.ts",
    "local:setup": "node --experimental-strip-types server/local/setup.ts",
    "local:start": "node --experimental-strip-types server/local/start.ts",
    "local:verify": "node --experimental-strip-types server/local/verify.ts",
    "local": "bash start-azulia.sh",
    "android:prepare": "npm run build && node scripts/prepare-android.mjs",
    "android:signing": "node scripts/create-android-signing.mjs",
    "android:apk": "npm run android:prepare && node scripts/build-android.mjs"
  },
  "dependencies": {
    "fflate": "^0.8.3",
    "mupdf": "1.28.1",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.1",
    "@types/node": "^22.20.5",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "4.3.4",
    "typescript": "5.7.3",
    "vite": "^6.4.5",
    "vitest": "^5.0.5"
  }
}
